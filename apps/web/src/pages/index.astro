---
import AcreditacionSection from "../components/astro/AcreditacionSection.astro";
import Button from "../components/astro/ui/Button.astro";
import IconFeature from "../components/astro/ui/IconFeature.astro";
import InfoCard from "../components/astro/ui/InfoCard.astro";
import SectionHeading from "../components/astro/ui/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const sedes = [
  {
    nombre: "SEDE LIMA",
    direccion: "Calle Verbenas N° 113. Urb. Salamanca, Ate – Lima.",
    correo: "mayker.ramos@instruingenieria.com",
    telefono: "+51 972 596 956",
  },
  {
    nombre: "SEDE LIMA SECUNDARIA",
    direccion: "Av. Guillermo Dansey N° 405. 3er piso, local 3142 - Cercado de Lima",
    correo: "ventas@instruingenieria.com",
    telefono: "+51 (01) 4076003 / +51 949 262 786",
  },
  {
    nombre: "SEDE JUNÍN",
    direccion: "Av. La Esperanza N° 966, El Tambo – Huancayo, Junín",
    correo: "ventastcmperu@gmail.com",
    telefono: "+51 991 454 729",
  },
];

// TODO: próxima pasada — reemplazar por GET /api/services?group=servicios
const servicios = [
  { label: "Metrología y calibración", icon: "/images/home/icon-voltimetro.png" },
  { label: "Inspección y verificación", icon: "/images/home/icon-manometro.png" },
  { label: "Mantenimiento de equipos", icon: "/images/home/icon-voltimetro.png" },
  { label: "Suministro de equipos", icon: "/images/home/icon-manometro.png" },
  { label: "Fabricación de equipos", icon: "/images/home/icon-voltimetro.png" },
  { label: "Consultoría y capacitación", icon: "/images/home/icon-manometro.png" },
];

const clientes = [
  { nombre: "APTIM", logo: "/images/clients/aptim.png" },
  { nombre: "ARCHROMA", logo: "/images/clients/archroma.png" },
  { nombre: "EQUANS", logo: "/images/clients/equans.png" },
  { nombre: "CONFIPETROL", logo: "/images/clients/confipetrol.png" },
  { nombre: "TECHINT", logo: "/images/clients/techim.png" },
  { nombre: "SIGDO KOPPERS", logo: "/images/clients/sigdo-koppers.png" },
  { nombre: "CUMBRA", logo: "/images/clients/cumbra.png" },
  { nombre: "ERIEZ FLOTATION", logo: "/images/clients/eriez-flotation.png" },
  { nombre: "SEPCON", logo: "/images/clients/sepcon.png" },
  { nombre: "RTS", logo: "/images/clients/rts.png" },
  { nombre: "Minera Chinalco", logo: "/images/clients/minera-chinalco.png" },
];
---

<BaseLayout title="Inicio">
  <section class="relative overflow-hidden bg-white pb-8 pt-0 md:pb-16">
    <div class="container-page grid items-center gap-6 md:grid-cols-2 md:gap-6">
      <div class="relative z-10 flex flex-col items-start gap-5 py-8 md:ml-10 md:gap-6 md:py-0 lg:ml-16">
        <p class="text-xl text-black md:text-2xl">Centro de Metrología especializado en la</p>
        <h1 class="text-[32px] font-bold uppercase leading-tight text-brand-purple md:text-[45px]">
          Calibración y ajuste de instrumentos de <span class="text-brand-red">medición</span>
        </h1>
        <p class="text-[24px] leading-snug text-black">
          Equipo de profesionales con asesoramiento especializado y vocación de servicio.
        </p>
        <div class="flex flex-wrap gap-4">
          <Button href="/nosotros" variant="secondary">Conoce más</Button>
          <Button href="/servicios" variant="primary">Ver servicios</Button>
        </div>
      </div>
      <div
        class="relative mx-auto w-[min(100%,22rem)] md:mx-0 md:w-auto md:-mr-[max(1.5rem,calc((100vw-var(--container-page))/2+1.5rem))] md:-mt-2"
      >
        <img
          src="/images/home/hero-bg.png"
          alt="Técnico calibrando un instrumento de medición"
          class="h-auto w-full max-w-none select-none"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="overflow-x-clip pt-16 pb-28">
    <div class="container-page flex justify-center">
      <div class="flex w-full max-w-[1100px] flex-col items-center gap-10 md:flex-row md:items-stretch md:gap-12">
        <div class="relative w-full max-w-[580px] shrink-0 pb-4 md:w-[52%]">
          <div
            aria-hidden="true"
            class="absolute inset-0 -translate-x-4 translate-y-1 -rotate-[3deg] rounded-card bg-brand-purple"
          ></div>
          <img
            src="/images/home/quienes-somos.png"
            alt="Equipo de Instruingeniería en campo"
            class="relative z-10 h-auto w-full rounded-card"
            loading="lazy"
          />
        </div>
        <div class="flex w-full max-w-[430px] flex-col items-start justify-center gap-4">
          <SectionHeading>¿Quiénes somos?</SectionHeading>
          <p class="text-[16px] leading-[1.55] text-black">
            Somos INSTRUINGENIERÍA S.A.C., una empresa peruana especializada en la venta, alquiler, calibración,
            certificación y mantenimiento preventivo de equipos industriales, cumpliendo con los estándares de calidad
            de la norma ISO 17025.
          </p>
          <p class="text-[16px] leading-[1.55] text-black">
            Contamos con un equipo de profesionales altamente capacitados, garantizando soluciones precisas y de alta
            calidad desde hace más de 7 años.
          </p>
          <p class="text-[16px] leading-[1.55] text-black">
            Nuestra misión es ofrecer servicios con precisión y confiabilidad en cada medición, asegurando así la
            satisfacción y confianza de nuestros clientes.
          </p>
          <Button href="/nosotros" variant="secondary">Ver más</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-brand-purple py-16 text-white">
    <div class="container-page flex flex-col items-center gap-4 text-center">
      <SectionHeading align="center" tone="white">Conoce nuestras sedes</SectionHeading>
      <p class="max-w-2xl text-base">
        Brindamos servicio a nivel nacional. INSTRUINGENIERIA S.A.C. cuenta con sedes a nivel nacional para
        brindarte la confianza y calidad en nuestros servicios, cada vez más cerca de ti.
      </p>
    </div>
    <div class="container-page mt-10 grid gap-6 md:grid-cols-3">
      {
        sedes.map((sede) => (
          <InfoCard class="text-center text-black">
            <img src="/images/shared/icon-location.png" alt="" class="mx-auto mb-3 h-10 w-10" />
            <h3 class="mb-2 text-xl font-bold uppercase text-brand-red">{sede.nombre}</h3>
            <p class="mb-4 text-sm font-medium">{sede.direccion}</p>
            <p class="text-sm text-black/70">{sede.correo}</p>
            <p class="text-sm text-black/70">{sede.telefono}</p>
          </InfoCard>
        ))
      }
    </div>
  </section>

  <section class="container-page py-16">
    <div class="grid grid-cols-2 items-center justify-items-start gap-[40px] lg:grid-cols-4">
      {
        servicios.map((servicio) => (
          <IconFeature icon={servicio.icon}>{servicio.label}</IconFeature>
        ))
      }
      <div class="col-span-2 flex flex-col items-start gap-4">
        <SectionHeading>Brindamos nuestro servicios a nivel nacional</SectionHeading>
        <p class="text-base text-black">
          Realizamos nuestros servicios a nivel nacional, en nuestras sedes en todo el Perú. También ofrecemos
          servicios en los establecimientos del Cliente (IN SITU).
        </p>
        <Button href="/servicios" variant="secondary">Ver todos los servicios</Button>
      </div>
    </div>
  </section>

  <AcreditacionSection align="center" />

  <section class="container-page flex flex-col items-center gap-4 py-16 text-center">
    <SectionHeading align="center">Nuestros principales clientes</SectionHeading>
    <p class="max-w-2xl text-base text-black">
      Colaboramos con líderes de la industria que confían en nuestra experiencia. Juntos construimos soluciones
      sostenibles, eficientes y de largo plazo.
    </p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-x-10 gap-y-8">
      {
        clientes.map((cliente) => (
          <img src={cliente.logo} alt={cliente.nombre} class="h-[84px] w-auto object-contain" loading="lazy" />
        ))
      }
    </div>
  </section>
</BaseLayout>
