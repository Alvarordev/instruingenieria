---
import ServiceForm from "../../../components/svelte/ServiceForm.svelte";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { apiJson } from "../../../lib/api";

interface Category {
  id: number;
  name: string;
  parentId: number | null;
}

const categories = (await apiJson<Category[]>("/api/categories")) ?? [];

const groupParam = Astro.url.searchParams.get("group");
const defaultGroup = groupParam === "servicios" ? "servicios" : "metrologia";
---

<AdminLayout title="Nuevo servicio">
  <h1 class="mb-6 text-2xl font-semibold text-brand-purple">Nuevo servicio</h1>
  <ServiceForm client:load categories={categories} defaultGroup={defaultGroup} />
</AdminLayout>
