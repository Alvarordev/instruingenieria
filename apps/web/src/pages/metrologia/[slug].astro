---
import ProductGrid from "../../components/astro/ProductGrid.astro";
import SectionHeading from "../../components/astro/ui/SectionHeading.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { apiJson } from "../../lib/api";

interface Lab {
  id: number;
  name: string;
  slug: string;
  description: string | null;
  categoryId: number | null;
  items: string[] | null;
}

interface Product {
  slug: string;
  name: string;
  tagline: string | null;
  imageUrl: string | null;
  type: "venta" | "alquiler";
}

const { slug } = Astro.params;
const lab = await apiJson<Lab>(`/api/services/${slug}`);

if (!lab) {
  return Astro.redirect("/metrologia");
}

const products = lab.categoryId
  ? ((await apiJson<Product[]>(`/api/products?category=${lab.categoryId}&type=venta`)) ?? [])
  : [];
---

<BaseLayout title={lab.name} description={lab.description ?? undefined}>
  <section class="container-page grid gap-10 py-16 md:grid-cols-[1.1fr_1fr] md:items-start">
    <div class="flex flex-col gap-4">
      <SectionHeading>{lab.name}</SectionHeading>
      {lab.description && <p class="text-[17px] leading-relaxed text-[#4e4e4e]">{lab.description}</p>}
    </div>
    {
      lab.items && lab.items.length > 0 && (
        <div class="rounded-card border border-black/10 bg-white p-8 shadow-sm">
          <h2 class="mb-4 text-lg font-semibold uppercase text-brand-purple">Equipos que calibramos</h2>
          <ul class="grid list-disc grid-cols-1 gap-x-8 gap-y-2 pl-5 text-sm text-[#4e4e4e] sm:grid-cols-2">
            {lab.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      )
    }
  </section>

  {
    products.length > 0 && (
      <section class="container-page flex flex-col gap-8 pb-16">
        <SectionHeading align="center">Calibración</SectionHeading>
        <ProductGrid products={products} />
      </section>
    )
  }
</BaseLayout>
