---
interface Props {
  name: string;
  slug: string;
}

const { name, slug } = Astro.props;
---

<a href={`/metrologia/${slug}`} class="lab-card group block">
  <div class="relative aspect-[379/242] w-full overflow-hidden rounded-[20px] bg-[#9e9e9e]">
    <span
      class="absolute bottom-5 left-1/2 z-10 flex min-h-[49px] w-max max-w-[calc(100%-1.5rem)] -translate-x-1/2 items-center justify-center rounded-full bg-brand-blue px-5 py-2.5 text-center text-[12px] font-bold uppercase leading-tight tracking-wide text-white transition-colors group-hover:bg-sky-600"
    >
      {name}
    </span>
  </div>
</a>
