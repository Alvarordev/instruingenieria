---
import Button from "./ui/Button.astro";

interface Props {
  name: string;
  slug: string;
  description?: string | null;
}

const { name, slug, description } = Astro.props;
---

<div class="flex flex-col items-center gap-3 rounded-card border border-black/10 bg-white p-6 text-center shadow-sm">
  <h3 class="text-lg font-semibold uppercase text-brand-purple">{name}</h3>
  {description && <p class="line-clamp-3 text-sm text-black/60">{description}</p>}
  <Button href={`/metrologia/${slug}`} variant="secondary" class="mt-2">
    Ver más
  </Button>
</div>
