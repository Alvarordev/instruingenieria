---
interface Brand {
  name: string;
  slug?: string;
  logoUrl?: string | null;
}

interface Props {
  brands: Brand[];
  title?: string;
}

const FIGMA_ORDER = ["sew-eurodrive", "megabras", "catu", "fluke", "amprobe"];

const FALLBACK_LOGO: Record<string, string> = {
  "sew-eurodrive": "/images/brands/sew-eurodrive.png",
  megabras: "/images/brands/megabras.png",
  catu: "/images/brands/catu.png",
  fluke: "/images/brands/fluke.png",
  amprobe: "/images/brands/amprobe.png",
};

const { brands, title = "Marcas que utilizamos" } = Astro.props;

const ordered = [...brands].sort((a, b) => {
  const ia = FIGMA_ORDER.indexOf(a.slug ?? "");
  const ib = FIGMA_ORDER.indexOf(b.slug ?? "");
  return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
});

function logoFor(brand: Brand) {
  if (brand.logoUrl) return brand.logoUrl;
  if (brand.slug && FALLBACK_LOGO[brand.slug]) return FALLBACK_LOGO[brand.slug];
  return null;
}
---

{
  ordered.length > 0 && (
    <section class="container-page flex flex-col items-center gap-6 py-12 text-center">
      <h2 class="font-display text-[26px] font-bold uppercase text-brand-purple">{title}</h2>
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-6 md:gap-x-12">
        {ordered.map((brand) => {
          const src = logoFor(brand);
          return src ? (
            <img src={src} alt={brand.name} class="h-[108px] w-auto max-w-[270px] object-contain" loading="lazy" />
          ) : (
            <span class="text-lg font-semibold text-black/70">{brand.name}</span>
          );
        })}
      </div>
    </section>
  )
}
