---
interface Props {
  product: {
    slug: string;
    name: string;
    tagline?: string | null;
    imageUrl: string | null;
    type: "venta" | "alquiler";
  };
}

const { product } = Astro.props;
---

<a
  class="product-card flex flex-col overflow-hidden rounded-card border border-black/10 bg-white shadow-sm transition-shadow hover:shadow-md"
  href={`/productos/${product.slug}`}
>
  <div class="flex aspect-square items-center justify-center bg-gray-100 p-4">
    {
      product.imageUrl ? (
        <img
          src={product.imageUrl}
          alt={product.name}
          loading="lazy"
          class="h-full w-full object-contain"
        />
      ) : (
        <div class="h-full w-full rounded-md bg-gray-200" aria-hidden="true" />
      )
    }
  </div>
  <div class="flex flex-1 flex-col items-center gap-1 px-4 py-4 text-center">
    <h3 class="text-base font-black uppercase text-brand-blue">{product.name}</h3>
    {product.tagline && <p class="text-xs text-black/60">{product.tagline}</p>}
    <span class="mt-3 inline-flex items-center justify-center rounded-pill bg-brand-blue px-5 py-1.5 text-xs font-black uppercase text-white">
      Ficha técnica
    </span>
  </div>
</a>
