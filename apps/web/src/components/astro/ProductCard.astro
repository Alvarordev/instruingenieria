---
interface Props {
  product: {
    slug: string;
    name: string;
    model?: string | null;
    tagline?: string | null;
    imageUrl: string | null;
    type: "venta" | "alquiler";
  };
  compact?: boolean;
}

const { product, compact = false } = Astro.props;
const model = product.model ?? product.tagline;
---

<a
  class:list={[
    "product-card flex h-full flex-col overflow-hidden rounded-[20px] border-[0.55px] border-black/20 bg-white shadow-[inset_0_0_6px_rgba(0,0,0,0.2)] transition-shadow hover:shadow-md",
    compact && "max-h-[290px]",
  ]}
  href={`/productos/${product.slug}`}
>
  <div class:list={["flex items-center justify-center p-4", compact ? "h-[138px] shrink-0" : "aspect-square"]}>
    {
      product.imageUrl ? (
        <img src={product.imageUrl} alt={product.name} loading="lazy" class="h-full w-full object-contain" />
      ) : (
        <div class="h-full w-full rounded-md bg-gray-200" aria-hidden="true" />
      )
    }
  </div>
  <div class="mx-4 border-t border-brand-blue"></div>
  <div class="flex flex-1 flex-col items-center gap-1 px-3 pb-4 pt-3 text-center">
    <h3
      class:list={[
        "uppercase leading-[18px] text-brand-blue",
        compact ? "text-base font-semibold" : "text-[15px] font-bold",
      ]}
    >
      {product.name}
    </h3>
    {model && <p class="text-xs text-[#4e4e4e]">MODELO: {model}</p>}
    <span
      class="mt-auto inline-flex h-9 w-[176px] max-w-full items-center justify-center rounded-[14px] bg-brand-blue text-sm font-black uppercase text-white"
    >
      Ver producto
    </span>
  </div>
</a>
