---
import Button from "./ui/Button.astro";
import SectionHeading from "./ui/SectionHeading.astro";

interface Props {
  image?: string;
}

const { image = "/images/home/certificado.png" } = Astro.props;
---

<section class="container-page grid gap-10 py-16 md:grid-cols-[minmax(0,420px)_1fr] md:items-center">
  <img
    src={image}
    alt="Certificado de calibración INACAL"
    class="w-full rounded-card object-cover shadow-sm"
    loading="lazy"
  />
  <div class="flex flex-col items-start gap-4">
    <SectionHeading>Acreditación</SectionHeading>
    <p class="text-base text-black">
      Acreditado por el organismo de acreditación INACAL- DA con registro N° LC – 016.
    </p>
    <Button href="/documentos/acreditacion.pdf" variant="secondary">Descargar PDF</Button>
  </div>
</section>
