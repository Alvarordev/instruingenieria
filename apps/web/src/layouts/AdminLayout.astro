---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Admin</title>
  </head>
  <body class="bg-gray-50">
    <div class="admin-layout grid min-h-screen grid-cols-[220px_1fr]">
      <aside class="admin-sidebar flex flex-col justify-between border-r border-black/10 bg-white p-6">
        <nav class="flex flex-col gap-1">
          <a href="/admin" class="rounded-md px-3 py-2 text-sm font-medium text-black hover:bg-gray-100">Dashboard</a>
          <a href="/admin/productos" class="rounded-md px-3 py-2 text-sm font-medium text-black hover:bg-gray-100">
            Productos
          </a>
          <a href="/admin/categorias" class="rounded-md px-3 py-2 text-sm font-medium text-black hover:bg-gray-100">
            Categorías
          </a>
          <a href="/admin/marcas" class="rounded-md px-3 py-2 text-sm font-medium text-black hover:bg-gray-100">
            Marcas
          </a>
          <a href="/admin/servicios" class="rounded-md px-3 py-2 text-sm font-medium text-black hover:bg-gray-100">
            Servicios
          </a>
        </nav>
        <button
          type="button"
          id="logout-button"
          class="w-full rounded-pill border border-black/15 px-4 py-2 text-sm font-medium text-black hover:bg-gray-100"
        >
          Salir
        </button>
      </aside>
      <div class="admin-content p-8">
        <slot />
      </div>
    </div>
    <script>
      document.getElementById("logout-button")?.addEventListener("click", async () => {
        await fetch("/api/auth/logout", { method: "POST" });
        window.location.href = "/admin/login";
      });
    </script>
  </body>
</html>
