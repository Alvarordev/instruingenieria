# Pinned to 1.3: Bun 1.4's Node-http-compat layer silently fails to accept
# connections when serving Astro's Node-adapter standalone server (verified
# locally — server logs "listening" but every request gets connection-refused).
FROM oven/bun:1.3 AS base
WORKDIR /app

FROM base AS deps
COPY package.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/api/package.json apps/api/package.json
COPY packages/db/package.json packages/db/package.json
RUN bun install

FROM deps AS build
COPY . .
RUN bun run --filter '@instru/web' build

FROM base AS runtime
ENV NODE_ENV=production PORT=3000 HOST=0.0.0.0
COPY --from=build /app /app
EXPOSE 3000
CMD ["bun", "./apps/web/dist/server/entry.mjs"]
