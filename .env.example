# Shared
NODE_ENV=development

# apps/api
PORT=4000
# DATABASE_URL and UPLOADS_DIR: leave unset for local dev (default to
# packages/db/data and apps/api/data). Docker sets absolute /data paths.
# DATABASE_URL=./data/db.sqlite
# UPLOADS_DIR=./data/uploads
SESSION_COOKIE_NAME=instru_session
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# apps/web
API_URL=http://localhost:4000
