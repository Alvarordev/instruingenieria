FROM oven/bun:1.3 AS base
WORKDIR /app

FROM base AS deps
COPY package.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/db/package.json packages/db/package.json
RUN bun install

FROM deps AS runtime
COPY . .
ENV NODE_ENV=production
EXPOSE 4000
VOLUME /data
CMD ["sh", "-c", "bun run --filter '@instru/db' migrate && bun run --filter '@instru/db' seed && bun run --filter '@instru/db' seed:catalog && bun run apps/api/src/index.ts"]
