{
  "name": "instruingenieria",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"bun run --env-file=.env --filter '@instru/web' dev\" \"bun run --env-file=.env --filter '@instru/api' dev\"",
    "build": "bun run --filter '@instru/web' build",
    "db:generate": "bun run --env-file=.env --filter '@instru/db' generate",
    "db:migrate": "bun run --env-file=.env --filter '@instru/db' migrate",
    "db:seed": "bun run --env-file=.env --filter '@instru/db' seed",
    "db:seed:catalog": "bun run --env-file=.env --filter '@instru/db' seed:catalog",
    "db:studio": "bun run --env-file=.env --filter '@instru/db' studio"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
